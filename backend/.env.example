# =====================================================================
#  Shaggar PMS — BACKEND settings (runs on Render)
#
#  On Render: paste these into the service → Environment (one line each).
#  On your own computer: copy this file to backend/.env and fill it in.
#  Never commit the real .env file — it holds passwords and keys.
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE — Neon (PostgreSQL)
#    Neon → your project → Connect → copy the connection string.
#    Leave empty to use a local SQLite file instead (good for trying it on a PC).
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-XXXX.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------
# 2. FILES — Supabase Storage (evidence files and backups)
#    Supabase → Project Settings → API Keys: copy the Project URL and a Secret key (sb_secret_...).
#    The bucket is created automatically as a PRIVATE bucket on first use.
#    Leave SUPABASE_URL empty to keep files on the server's own disk instead.
# ---------------------------------------------------------------------
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_BUCKET=shaggar-pms

# ---------------------------------------------------------------------
# 3. CONNECTION WITH THE FRONTEND (Vercel)
#    Make a long random value (for example: openssl rand -hex 32) and put the SAME value
#    here and in Vercel (frontend/.env.example → ORIGIN_SECRET).
#    The API then answers only requests that come through your Vercel site.
# ---------------------------------------------------------------------
ORIGIN_SECRET=change-me-to-a-long-random-value-64-characters-long-xxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# 4. SERVER AND SECURITY
# ---------------------------------------------------------------------
NODE_ENV=production
# Render sets PORT itself; 8080 is used on your own computer.
PORT=8080
# true when the site is served over HTTPS (it is on Vercel and Render).
SECURE_COOKIES=true
# true behind a hosting proxy (Render), so sign-in limits count each visitor separately.
TRUST_PROXY=true
# Keep true until email for sign-in codes works (System Guide, section 9). Then set false.
# While true, the sign-in page lists the demo accounts and shows the 6-digit code.
DEMO_MODE=true
# Password given to the demo accounts when the database is first created. Change it.
DEMO_PASSWORD=Choose-A-Strong-Password-2026!
# How often (minutes) reminders, escalations and the daily backup are checked.
# 30 keeps the Neon database asleep most of the time, which saves its free compute hours.
SCHEDULER_MINUTES=30

# ---------------------------------------------------------------------
# 5. EMAIL — sign-in codes and notifications (needed before real use)
#    Brevo: Settings → SMTP & API → API keys. Verify the sender address in Brevo first.
#    Or use Resend: set RESEND_API_KEY instead of BREVO_API_KEY.
# ---------------------------------------------------------------------
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=no-reply@your-domain.gov.et
EMAIL_FROM_NAME=Shaggar PMS

# ---------------------------------------------------------------------
# 6. OPTIONAL
# ---------------------------------------------------------------------
# AI assistant with a Claude model (without it, the built-in assistant answers).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# SMS gateway (used only after it is approved under Notifications → Channels).
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Extra sites allowed to send changes, comma-separated (normally not needed with ORIGIN_SECRET).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# Only when running WITHOUT Neon/Supabase (local SQLite and folders):
# ---------------------------------------------------------------------
# DB_FILE=./storage/shaggar-pms.db
# UPLOADS_DIR=./storage/uploads
# BACKUPS_DIR=./storage/backups
