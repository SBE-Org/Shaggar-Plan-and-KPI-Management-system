# =====================================================================
#  Shaggar PMS — FRONTEND settings (the website on Vercel)
#
#  1. Copy this file to frontend/.env and fill in BACKEND_URL.
#  2. Run once:   node scripts/configure-vercel.js
#     It writes vercel.json so that /api/* on your Vercel site goes to the backend.
#     Commit vercel.json (not frontend/.env) and push.
#  3. In Vercel → your project → Settings → Environment Variables, add ORIGIN_SECRET
#     with the same value as on Render. Vercel attaches it to every request it
#     forwards to the backend; it is never sent to visitors' browsers.
# =====================================================================

# Address of the backend on Render (no slash at the end).
BACKEND_URL=https://shaggar-pms.onrender.com

# The same long random value as ORIGIN_SECRET in the backend settings.
ORIGIN_SECRET=change-me-to-a-long-random-value-64-characters-long-xxxxxxxxxxxxxxxxxx
