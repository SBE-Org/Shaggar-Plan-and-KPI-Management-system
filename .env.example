# Copy to .env and adjust. Every value is optional; defaults are shown.

# --- server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Set to true when the site is served over HTTPS (Secure cookies + HSTS)
SECURE_COOKIES=false

# DEMO_MODE=true lists demo accounts on the sign-in page and shows the one-time
# code on screen while the SMS gateway is not approved. MUST be false in production.
DEMO_MODE=true
DEMO_PASSWORD=Shaggar@2026

# --- storage (defaults to ./storage) ---
# DB_FILE=./storage/shaggar-pms.db
# UPLOADS_DIR=./storage/uploads
# BACKUPS_DIR=./storage/backups
PASSWORD_ITERATIONS=120000
MAX_BODY_MB=15
SCHEDULER_MINUTES=10

# --- notification gateways (used only after approval in Notifications → Channels) ---
# Generic HTTP JSON gateways: POST {to, from, message} / {to, from, subject, text}
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
EMAIL_API_URL=
EMAIL_API_TOKEN=

# --- AI executive assistant (optional; the first configured provider is used) ---
# Option A: Anthropic Claude API (paid per use)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Option B: self-hosted open model with Ollama (free licence, needs a server/GPU)
OLLAMA_URL=
OLLAMA_MODEL=llama3.1

# --- email for sign-in codes and notifications ---
# Sign-in codes are emailed to the address on each account. Most hosts (Railway
# included) block direct mail ports, so email goes through an HTTPS email service.
# Create a free account with one of these, verify your sender address there, and
# set its API key here together with EMAIL_FROM.
BREVO_API_KEY=
RESEND_API_KEY=
# The verified sender address, and the name shown to recipients
EMAIL_FROM=
EMAIL_FROM_NAME=Shaggar PMS
